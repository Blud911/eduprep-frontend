# ============================================================
# EDUPREP CI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env sur GitHub
# ============================================================

# Serveur
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# Base de données PostgreSQL (Render)
DATABASE_URL=postgresql://user:password@host:5432/eduprep_db

# JWT
JWT_SECRET=remplacer_par_une_chaine_aleatoire_tres_longue_minimum_64_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=remplacer_par_une_autre_chaine_aleatoire_tres_longue
JWT_REFRESH_EXPIRES_IN=30d

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Email (Brevo / SendGrid)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=noreply@eduprep-ci.brevo.com
SMTP_PASS=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
EMAIL_FROM=noreply@eduprep-ci.brevo.com
EMAIL_FROM_NAME=EduPrep_CI

# Admin
ADMIN_EMAIL=amospehankpa@gmail.com

# Plans tarifaires (montants en FCFA)
PRICE_STARTER=2000
PRICE_PRO=5000
PRICE_ETABLISSEMENT=30000

# Limites quotas
QUOTA_STARTER_FICHES=20
QUOTA_STARTER_DEVOIRS=10
QUOTA_PRO_FICHES=-1
QUOTA_PRO_DEVOIRS=-1
QUOTA_ETABLISSEMENT_USERS=20
